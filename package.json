{
  "name": "nexus-agent",
  "productName": "Nexus Agent",
  "version": "0.1.0",
  "description": "多 Agent 研发管理桌面应用：机械、电子、嵌入式、论文四个专业 Agent 的创建、调度、审批与成本统计（基于 Claude Agent SDK）",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "MingshanHe",
  "homepage": "https://github.com/MingshanHe/Nexus-Agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/MingshanHe/Nexus-Agent.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
